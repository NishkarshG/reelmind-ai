# Copy to backend/.env and fill in. Never commit the real file.
# Google Gemini key (starts with AIza...) — "Google Gemini" provider
GEMINI_API_KEY=
# OpenRouter key (starts with sk-or-...) — "OpenRouter" provider (Gemma, Llama, Gemini, ...)
OPENROUTER_API_KEY=
# Optional: comma-separated list of allowed frontend origins (default "*")
CORS_ORIGINS=http://localhost:5173
